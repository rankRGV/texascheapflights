---
export const prerender = true;
import '../styles/global.css';
import GlobalNav from '../components/GlobalNav.astro';
import GlobalFooter from '../components/GlobalFooter.astro';

const OBJECTIONS = [
  {
    id: 'real',
    q: "Are these deals actually real? I've seen too many bait-and-switch 'deal alerts.'",
    a: "Every deal we've ever sent is published at texascheapflights.com/past-deals — real routes, real prices, real airlines. No cherry-picking, no expired listings dressed up as wins. AI Scout scores every opportunity on a composite model: relative value for the route, live market context, and whether it's actually bookable from a Texas airport. Below a 7, it doesn't go out. Most days, nothing goes out. That's a feature, not a bug.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    id: 'speed',
    q: "By the time the alert hits my inbox, the price is already back to normal.",
    a: "That's the most legitimate objection to any deal alert service — and the reason we built our own monitoring bot instead of scraping deal blogs or following Twitter threads. The bot flags the anomaly and fires the alert in the same automated pass. No human editorial step, no virality delay, no 'we saw it on Reddit six hours ago.' Error fare windows typically last 2–24 hours. We can't promise every deal survives your morning coffee, but we can promise we're faster than any manually-curated list.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
  },
  {
    id: 'spam',
    q: "I've tried 'cheap flight' services before. I just got spammed with mediocre sales.",
    a: "Most services define a deal as anything cheaper than last week. We don't. A true deal scores high because the relative value is extreme — think a strong legacy-carrier fare or a major route dropping far below what similar trips are clearing for in the current market. A fare that's only a little off normal is not a deal and it doesn't go out. Your inbox should contain opportunities, not noise you have to filter yourself.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>`
  },
  {
    id: 'points',
    q: "Do I need to know about credit cards and points to use this?",
    a: "No. About half of what we send are straight cash fares — error fares where an airline's algorithm misfired and sold a $1,400 roundtrip for $250. No points, no card strategy, no rewards math. Just book it like any other ticket. If you want to layer in the award side — zone-based redemptions, partner sweet spots where your miles go 3x further — we cover that too. But it's never a requirement to get value here.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`
  },
  {
    id: 'regional',
    q: "I fly out of McAllen or Laredo. The good deals are all for DFW, right?",
    a: "The most expensive myth in Texas travel. For cash error fares, airlines propagate the glitch price across airports — that $180 fare from DFW often shows up at MFE, LRD, and HRL at the same price. For award travel, programs price by zone, not mileage — a flight from Laredo to London can redeem for the same points as one from Dallas. We specifically monitor regional TX airports because the arbitrage is bigger there, not smaller. Regional is an advantage.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Skeptic's Guide to Texas Cheap Flights</title>
  <meta name="description" content="Are error fares real? Will the alert be too late? Do you need to know about points? Honest answers to every skeptic's question about Texas Cheap Flights." />
  <link rel="canonical" href="https://texascheapflights.com/skeptics-guide" />
  <meta property="og:title" content="The Skeptic's Guide to Texas Cheap Flights" />
  <meta property="og:description" content="Are error fares real? Will the alert be too late? Do you need to know about points? Honest answers — no hype." />
  <meta property="og:image" content="https://texascheapflights.com/og-image.png" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Are flight deal alerts actually real, or is it bait-and-switch?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every deal Texas Cheap Flights has ever sent is published publicly at texascheapflights.com/past-deals — real routes, real prices, real airlines. AI Scout scores every opportunity and only sends alerts that score 7 or above on a composite model including relative route value, live market context, and Texas airport accessibility."
        }
      },
      {
        "@type": "Question",
        "name": "By the time the alert reaches me, is the deal already gone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Texas Cheap Flights runs its own monitoring bot that fires alerts in the same automated pass as the anomaly detection — no human editorial step or virality delay. Error fare windows typically last 2–24 hours. While no service can guarantee a deal survives, direct bot-to-inbox delivery is significantly faster than manually curated lists."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to know about points and credit cards to use Texas Cheap Flights?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. About half of the alerts are straight cash error fares — when an airline's pricing algorithm misfires and sells a $1,400 roundtrip for $250. No points, no credit card strategy required. Award sweet spots are also tracked for subscribers who want to use miles, but it's entirely optional."
        }
      },
      {
        "@type": "Question",
        "name": "What is an error fare?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An error fare is when an airline's pricing algorithm makes a mistake — sometimes pricing a route far below its normal rate. These fares are legal to book and are often honored, but airlines can cancel and refund mistaken fares in some cases. These windows typically close quickly once discovered, which is why immediate alerts matter."
        }
      },
      {
        "@type": "Question",
        "name": "Do you find deals from regional Texas airports like McAllen, Laredo, or Harlingen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — and regional airports often have better opportunities. Cash error fares propagate across airports at the same glitch price. For award travel, programs price by geographic zone, not distance — meaning a flight from Laredo can redeem for the same miles as one from Dallas. Texas Cheap Flights monitors all 19 Texas airports specifically because regional airports can be an advantage, not a limitation."
        }
      }
    ]
  }
  </script>

  <!-- Fonts (async — non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://api.fontshare.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap">
  </noscript>
</head>

<body class="bg-primary text-primary font-body selection:bg-tcf-aviation-blue/30 selection:text-tcf-ink">

  <GlobalNav activePage="skeptics-guide" />

  <main class="pt-32 pb-20 px-6">
    <div class="max-w-4xl mx-auto">

      <!-- Hero -->
      <header class="text-center mb-20 anim-fade-up">
        <span class="label text-gold uppercase tracking-[0.3em] font-bold text-xs mb-6 inline-block">The Honest Breakdown</span>
        <h1 class="text-5xl md:text-7xl mb-8 text-tcf-ink font-black leading-tight">
          The Skeptic's Guide to <span class="text-gold">Texas Cheap Flights</span>
        </h1>
        <p class="text-xl text-tcf-ink-muted max-w-2xl mx-auto leading-relaxed">
          Are these deals real? Will alerts arrive in time? Do you need to know about points?<br/><span class="text-tcf-ink font-bold">Straight answers. No gurus. No pitch.</span>
        </p>
        <p class="text-center text-[10px] text-tcf-ink-muted font-bold uppercase tracking-widest mt-8">
          Last updated: <time datetime="2026-03-08">March 8, 2026</time>
        </p>
      </header>

      <!-- Objections List -->
      <section class="space-y-12 mb-32">
        <h2 class="text-3xl font-black text-center text-tcf-ink mb-16">Five objections. Five honest answers.</h2>
        <div class="grid gap-8">
          {OBJECTIONS.map(obj => (
            <div id={obj.id} class="liquid-glass p-8 md:p-12 rounded-[2.5rem] border-tcf-ink/10 hover:border-tcf-ink/10 transition-all duration-300">
              <div class="flex flex-col md:flex-row gap-8">
                <div class="w-16 h-16 rounded-2xl bg-tcf-gold/10 flex items-center justify-center text-tcf-gold-deep flex-shrink-0" set:html={obj.icon}></div>
                <div>
                  <h3 class="text-2xl font-black text-tcf-ink mb-4 tracking-tight">{obj.q}</h3>
                  <p class="text-lg text-tcf-ink-muted leading-relaxed font-body">{obj.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Rule #1: Error Fares Are Legal -->
      <section class="mb-32">
        <div class="liquid-glass p-10 md:p-16 rounded-[3rem] relative overflow-hidden">
          <div class="absolute -top-20 -left-20 w-64 h-64 bg-tcf-aviation-blue/10 blur-[120px] rounded-full"></div>

          <h2 class="text-3xl font-black mb-6 text-tcf-ink">Rule #1: Error fares are legal to book — but never guaranteed.</h2>
          <p class="text-tcf-ink-muted mb-8 leading-relaxed text-lg font-body">
            An error fare happens when a carrier's pricing system misfires — a currency conversion glitch, a misplaced decimal, a data feed error — and publishes a fare at a fraction of its intended price. They're not a loophole or a hack. They're a pricing mistake.
          </p>
          <div class="grid md:grid-cols-2 gap-10">
            <div class="space-y-4">
              <h3 class="text-tcf-ink font-bold flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-tcf-aviation-blue/20 flex items-center justify-center text-[10px] text-tcf-aviation-blue">1</span>
                Are they guaranteed to honor it?
              </h3>
              <p class="text-sm text-tcf-ink-muted leading-relaxed font-body">
                No service can guarantee that. Many error fares are honored after ticketing, but airlines can identify a mistaken fare, cancel the booking, and refund the charge. That is why we frame these as time-sensitive opportunities with risk, not guaranteed inventory.
              </p>
            </div>
            <div class="space-y-4">
              <h3 class="text-tcf-ink font-bold flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-tcf-aviation-blue/20 flex items-center justify-center text-[10px] text-tcf-aviation-blue">2</span>
                What's the worst case?
              </h3>
              <p class="text-sm text-tcf-ink-muted leading-relaxed font-body">
                The most common downside is a cancellation and refund from the airline. You may lose the time it took to book, and you should not make non-refundable hotel or activity plans until the ticket is confirmed and stable. Low-confidence glitches get held back.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Rule #2: The Two Types -->
      <section class="mb-32">
        <div class="liquid-glass p-10 md:p-16 rounded-[3rem] relative overflow-hidden border border-red-500/10">
          <div class="absolute -top-20 -right-20 w-64 h-64 bg-red-500/5 blur-[120px] rounded-full"></div>
          <div class="relative z-10">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-[9px] font-black uppercase tracking-widest text-red-400 mb-8 inline-block">
              ⚡ Two Types, One Service
            </span>
            <h2 class="text-3xl font-black mb-6 text-tcf-ink">Rule #2: There are two types of deals. You benefit from both.</h2>
            <div class="grid md:grid-cols-2 gap-10">
              <div>
                <p class="text-xs font-black text-red-400 uppercase tracking-widest mb-3">Cash Error Fares</p>
                <p class="text-tcf-ink-muted leading-relaxed font-body">
                  When an airline's algorithm misfires and publishes a $1,200 roundtrip for $180. No points. No cards. Buy it like any normal ticket. These glitch windows are real, they happen weekly, and they close within hours. By the time it surfaces on a deal blog, it's usually patched. We send the alert the moment the bot catches it.
                </p>
              </div>
              <div>
                <p class="text-xs font-black text-tcf-aviation-blue uppercase tracking-widest mb-3">Award Sweet Spots</p>
                <p class="text-tcf-ink-muted leading-relaxed font-body">
                  When an airline's award chart prices a route by geographic zone instead of distance — meaning a flight from McAllen to London can cost the same miles as DFW to London. These aren't errors. They're structural advantages baked into the program that most Texans don't know about.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- The Texas Edge -->
      <section class="mb-32 text-center">
        <div class="p-12 md:p-20 rounded-[4rem] bg-tcf-gold/5 border border-tcf-gold/10 relative overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tcf-gold)_0%,_transparent_20%)] opacity-10"></div>
          <h2 class="text-4xl md:text-5xl font-black text-tcf-ink mb-8">Still not convinced? See every deal we've actually sent.</h2>
          <p class="text-xl text-tcf-ink-muted max-w-2xl mx-auto mb-8 font-body">
            Real routes. Real prices. Real airlines. Every deal AI Scout has found and sent to Texas subscribers — publicly archived and never edited. From <span class="text-tcf-gold-deep font-bold">MFE, LRD, BRO, CRP, HRL</span> and every major Texas airport.
          </p>
          <p class="text-lg text-tcf-ink font-bold mb-10">No cherry-picking. No expired deals dressed up as wins. Just the actual record.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-6 w-full">
          <a href="/#waitlist" class="btn-primary w-full sm:w-auto px-16 py-6 text-xl">
            Secure My Early Access
          </a>
        </div>
        <p class="mt-8 text-tcf-ink-muted text-xs font-black uppercase tracking-[0.2em]">
          Free to join · Unsubscribe anytime
        </p>
      </div>
    </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="py-20 bg-tcf-cream border-t border-tcf-ink/10 text-center">
    <p class="text-tcf-ink-muted text-xs font-bold uppercase tracking-widest">
      © 2026 Texas Cheap Flights. No fluff, just math.
    </p>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('anim-fade-up');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.anim-fade-up, .liquid-glass').forEach(el => observer.observe(el));
  </script>
</body>
</html>
