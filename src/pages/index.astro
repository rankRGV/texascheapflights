        "@type": "FAQPage",
        "@id": "https://texascheapflights.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How is this different from Scott's Cheap Flights or Going?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Generic deal sites focus on huge hubs like JFK or LAX. We are built specifically for Texas. We track regional feeders like McAllen, Laredo, and Harlingen, and we include award sweet spots (points) which most other sites ignore."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to live in a major city like Dallas or Houston?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. In fact, we built this because regional Texas airports are often overlooked. We monitor 15+ Texas airports including MFE, LRD, BRO, CRP, and ELP."
            }
          },
          {
            "@type": "Question",
            "name": "What is an 'Error Fare'?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "An error fare is when an airline's pricing algorithm makes a mistake, sometimes selling international tickets for 50-90% off. These 'glitch' windows usually close within hours, which is why we send alerts immediately."
            }
          }
        ]
      }
    ]
  }
