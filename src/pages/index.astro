---
import '../styles/global.css';

const TX_AIRPORTS = [
  { code: 'MFE', city: 'McAllen' },
  { code: 'HRL', city: 'Harlingen' },
  { code: 'BRO', city: 'Brownsville' },
  { code: 'LRD', city: 'Laredo' },
  { code: 'CRP', city: 'Corpus Christi' },
  { code: 'MAF', city: 'Midland / Odessa' },
  { code: 'SAT', city: 'San Antonio' },
  { code: 'AUS', city: 'Austin' },
  { code: 'IAH', city: 'Houston (Bush)' },
  { code: 'HOU', city: 'Houston (Hobby)' },
  { code: 'DFW', city: 'Dallas / Fort Worth' },
  { code: 'DAL', city: 'Dallas (Love Field)' },
  { code: 'ELP', city: 'El Paso' },
  { code: 'LBB', city: 'Lubbock' },
  { code: 'AMA', city: 'Amarillo' },
];

const PAIN_QUOTES = [
  { icon: '😤', text: '"I have 60,000 Chase points and zero idea what they\'re worth."' },
  { icon: '😰', text: '"Every time I search from Laredo, flights are $800. There has to be a better way."' },
  { icon: '🤯', text: '"I tried reading The Points Guy. Two hours later I was more confused than before."' },
];

const HOW_IT_WORKS = [
  { step: '01', icon: '📍', title: 'Tell us your Texas airport', desc: 'From MFE to DFW, we know the best routes, sweet spots, and partner awards specific to your airport — not generic advice built for JFK flyers.' },
  { step: '02', icon: '🗺️', title: 'Pick your dream destination', desc: 'Tokyo, Cancun, London, Orlando. We reverse-engineer exactly which points you need, which card earns them fastest, and when to book.' },
  { step: '03', icon: '🛡️', title: 'Fly smart. Never get burned.', desc: 'We show you how to hedge with refundable awards and backup routes — so price spikes and flight changes never ruin your plans again.' },
];

const HEDGING_TRIPS = [
  { route: 'MFE → DFW → London', status: 'Hedged ✅', color: 'var(--tcf-success)' },
  { route: 'AUS → Tokyo via ANA', status: 'Backup ready ⚡', color: 'var(--tcf-caution)' },
  { route: 'DFW → Cancun award', status: 'Refundable 🛡️', color: 'var(--tcf-success)' },
];

const AIRPORTS = [
  { code: 'MFE', city: 'McAllen', hot: true },
  { code: 'HRL', city: 'Harlingen', hot: true },
  { code: 'BRO', city: 'Brownsville', hot: true },
  { code: 'LRD', city: 'Laredo', hot: true },
  { code: 'CRP', city: 'Corpus Christi', hot: true },
  { code: 'MAF', city: 'Midland', hot: false },
  { code: 'SAT', city: 'San Antonio', hot: false },
  { code: 'AUS', city: 'Austin', hot: false },
  { code: 'IAH', city: 'Houston', hot: false },
  { code: 'DFW', city: 'Dallas', hot: false },
  { code: 'ELP', city: 'El Paso', hot: false },
];

const ETHICS = [
  { icon: '🛡️', text: 'Never push you into debt' },
  { icon: '📋', text: 'Affiliate disclosure on every card' },
  { icon: '✅', text: 'Safety ratings on every strategy' },
  { icon: '🎯', text: 'Your airport. Your plan.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0d1832" />
  <title>Texas Cheap Flights — Travel Hacking Built for Texans</title>
  <meta name="description" content="The first travel hacking platform built specifically for Texas travelers. Enter your home airport, get your personalized plan to fly anywhere for less." />
  <meta property="og:title" content="Texas Cheap Flights — Travel Hacking Built for Texans" />
  <meta property="og:description" content="Enter your Texas airport. Get your personalized plan to fly anywhere for less." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>" />
</head>

<body class="bg-primary text-primary scroll-smooth">

  <!-- ═══════════════════════════ NAV ═══════════════════════════ -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 px-6 py-5 transition-all duration-300 glass border-b border-white/5">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <span class="text-3xl anim-float">✈️</span>
        <div class="flex flex-col leading-none">
          <span class="label text-gold-solid tracking-[0.2em] mb-0.5">Texas</span>
          <span class="font-black text-sm uppercase tracking-wider">Cheap Flights</span>
        </div>
      </div>
      <!-- CTA -->
      <a href="#waitlist" class="btn-primary" style="padding: 0.625rem 1.5rem; font-size: 0.875rem;">
        Early Access
      </a>
    </div>
  </nav>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="hero-gradient relative min-h-screen flex items-center justify-center px-6 pt-32 pb-20 overflow-hidden">
    <div class="starfield"></div>

    <!-- Ambient Glows -->
    <div class="absolute top-1/4 -right-20 w-96 h-96 bg-tcf-gold/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-tcf-navy-mid/10 blur-[120px] rounded-full"></div>

    <div class="z-content max-w-5xl mx-auto flex flex-col items-center text-center">

      <!-- Badge -->
      <div class="anim-fade-up delay-1 inline-flex items-center gap-2 badge badge-gold mb-10">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tcf-gold opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-tcf-gold"></span>
        </span>
        Early access now open for all TX airports
      </div>

      <!-- Hero headline -->
      <h1 class="anim-fade-up delay-2 display mb-8 text-white" style="font-size: clamp(2.5rem, 8vw, 5.5rem);">
        Travel hacking<br/>
        <span class="text-gold">built specifically</span><br/>
        for Texas flyers.
      </h1>

      <!-- Subheadline -->
      <p class="anim-fade-up delay-3 body max-w-2xl text-xl mb-12">
        Most experts teach you how to earn points. We teach you how to <span class="text-white font-medium">actually use them</span> without getting burned by regional price hikes.
      </p>

      <!-- WAITLIST FORM -->
      <div class="anim-fade-up delay-4 w-full max-w-lg" id="waitlist">
        <div class="glass card p-8 md:p-10 shadow-2xl shadow-black/50">
          <form id="waitlist-form" class="flex flex-col gap-5">
            <div class="flex flex-col gap-2 text-left">
              <label class="label text-slate-400">Home Airport</label>
              <select id="airport" name="airport" required class="input">
                <option value="" disabled selected>Choose your airport...</option>
                {TX_AIRPORTS.map(a => (
                  <option value={a.code}>{a.city} ({a.code})</option>
                ))}
              </select>
            </div>

            <div class="flex flex-col gap-2 text-left">
              <label class="label text-slate-400">Email Address</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="you@email.com"
                class="input"
              />
            </div>

            <button type="submit" id="submit-btn" class="btn-primary w-full mt-2">
              Get My Personalized TX Plan &nbsp; ✈️
            </button>

            <p class="text-center text-xs text-slate-500">
              No credit card required. Private early access.
            </p>
          </form>

          <!-- Success state -->
          <div id="success-state" class="hidden text-center py-4">
            <div class="text-5xl mb-4">🤠</div>
            <h3 class="subhead text-2xl mb-2 text-gold-solid">You're in the inner circle.</h3>
            <p class="body mb-8 text-slate-400">We're building your sweet-spot report for your airport now.</p>

            <div class="glass-success p-6 rounded-2xl border border-tcf-success/20">
              <p class="font-bold text-tcf-success mb-2 uppercase tracking-widest text-xs">🚀 Skip the line</p>
              <p class="text-sm text-slate-300 mb-4">
                Refer 3 friends from Texas and get instant access to our "Airport Sweet Spot" hidden database.
              </p>
              <div class="flex gap-2">
                <input id="referral-link" readonly value="txflights.co/ref/TEXAS" class="input flex-1 text-sm bg-black/40" />
                <button id="copy-btn" class="btn-secondary whitespace-nowrap text-sm px-4">Copy</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Proof -->
        <div class="mt-8 flex items-center justify-center gap-3 text-sm text-slate-500">
          <div class="flex -space-x-3">
            {[1,2,3].map(() => (
              <div class="w-8 h-8 rounded-full border-2 border-tcf-navy-deep bg-tcf-navy-mid flex-center text-[10px] glass">⭐</div>
            ))}
          </div>
          <p><span class="text-white font-bold">247 Texans</span> joined this week</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ PAIN ═══════════════════════════ -->
  <section class="section-padding bg-deep relative border-y border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="label text-gold-solid">The Reality</span>
        <h2 class="heading text-4xl md:text-5xl mt-4 mb-6">Standard travel hacking<br/><span class="text-slate-500 italic">doesn't work for us.</span></h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {PAIN_QUOTES.map(item => (
          <div class="glass p-8 rounded-3xl flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-2xl bg-white/5 flex-center text-3xl mb-6">{item.icon}</div>
            <p class="body text-white font-medium italic leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ HOW IT WORKS ═══════════════════════════ -->
  <section class="section-padding hero-gradient">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-20">
        <span class="label text-blue">The Strategy</span>
        <h2 class="heading text-4xl md:text-5xl mt-4">Three steps to<br/><span class="text-gold">mastering your miles.</span></h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {HOW_IT_WORKS.map((f, idx) => (
          <div class={`glass p-10 rounded-[32px] relative overflow-hidden group hover:border-tcf-gold/30 transition-all duration-500 anim-fade-up delay-${idx+1}`}>
            <span class="absolute top-6 right-8 text-7xl font-black text-white/5 select-none">{f.step}</span>
            <div class="text-4xl mb-8 group-hover:scale-110 transition-transform duration-500">{f.icon}</div>
            <h3 class="subhead text-2xl mb-4 text-white">{f.title}</h3>
            <p class="body">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ TRAVEL HEDGING ═══════════════════════════ -->
  <section class="section-padding bg-black/20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="badge badge-gold px-4 py-1.5 label text-[10px] mb-8">Proprietary Framework</span>
          <h2 class="heading text-4xl md:text-5xl mb-8 leading-tight">
            Stop guessing.<br/>
            Start <span class="text-gold">Hedging.</span>
          </h2>
          <p class="body text-lg mb-10 leading-relaxed">
            Cash prices are volatile. Rewards are stable. We teach you how to book refundable "hedge flights" using points you already have, so you NEVER pay a last-minute price spike again.
          </p>
          
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { icon: '🛡️', title: 'Refundable awards', desc: 'Lock in deals with 0 risk.' },
              { icon: '🔄', title: 'Backup routes', desc: 'Always have a plan B.' },
              { icon: '📊', title: 'Risk scoring', desc: 'Know when to pay cash.' },
              { icon: '🔥', title: 'Sweet spots', desc: 'Airport-specific secrets.' },
            ].map(item => (
              <div class="flex gap-4">
                <div class="text-2xl pt-1">{item.icon}</div>
                <div>
                  <h4 class="font-bold text-white text-sm mb-1">{item.title}</h4>
                  <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Dashboard Mockup -->
        <div class="relative group">
          <div class="absolute -inset-4 bg-tcf-gold/20 blur-3xl rounded-full opacity-50 group-hover:opacity-70 transition-opacity"></div>
          <div class="glass rounded-3xl p-8 relative overflow-hidden border-white/10 shadow-2xl">
            <div class="flex items-center justify-between mb-10">
              <h4 class="label text-slate-400">Hedge Portfolio</h4>
              <div class="flex gap-1.5">
                <span class="w-2 h-2 rounded-full bg-red-500/50"></span>
                <span class="w-2 h-2 rounded-full bg-tcf-caution/50"></span>
                <span class="w-2 h-2 rounded-full bg-tcf-success/50"></span>
              </div>
            </div>
            
            <div class="space-y-4 mb-8">
              {HEDGING_TRIPS.map(trip => (
                <div class="p-4 rounded-2xl bg-white/5 border border-white/5 flex items-center justify-between hover:bg-white/10 transition-colors">
                  <div>
                    <div class="font-bold text-sm text-white mb-0.5">{trip.route}</div>
                    <div class="text-[10px] uppercase tracking-widest font-bold opacity-70" style={`color: ${trip.color}`}>{trip.status}</div>
                  </div>
                  <div class="h-1 w-16 bg-white/10 rounded-full overflow-hidden">
                    <div class="h-full bg-tcf-gold w-3/4"></div>
                  </div>
                </div>
              ))}
            </div>

            <div class="p-4 rounded-2xl glass-success text-center">
              <p class="font-bold text-tcf-success text-xs">✅ STATUS: INSULATED</p>
              <p class="text-[10px] text-slate-400 mt-1">Your summer vacation is protected against price hikes.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ AIRPORTS ═══════════════════════════ -->
  <section class="section-padding bg-deep border-y border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="label text-gold-solid mb-4">Texas Coverage</span>
      <h2 class="heading text-4xl md:text-5xl mt-4 mb-8">We track <span class="text-gold">15 Texas hubs.</span></h2>
      <p class="body text-lg mb-16 mx-auto max-w-2xl">
        From the Valley to the Panhandle. We monitor award availability and cash routes for every regional airport in the state.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        {AIRPORTS.map(a => (
          <div class={`badge px-4 py-2 text-sm font-bold ${a.hot ? 'badge-gold' : 'glass bg-white/5 text-slate-400 border-white/5'}`}>
            {a.code} <span class="mx-1 opacity-30 font-light">|</span> {a.city} {a.hot && '🔥'}
          </div>
        ))}
        <div class="badge px-4 py-2 text-sm font-bold glass bg-white/5 text-slate-500 italic border-white/5">+4 more hubs</div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ ETHICS ═══════════════════════════ -->
  <section class="py-12 glass border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {ETHICS.map(item => (
          <div class="flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
            <span class="text-3xl">{item.icon}</span>
            <span class="text-sm font-semibold text-white/80">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ FINAL CTA ═══════════════════════════ -->
  <section class="section-padding hero-gradient relative overflow-hidden">
    <div class="starfield"></div>
    <div class="z-content max-w-3xl mx-auto text-center px-6">
      <div class="text-6xl mb-10 anim-float">✈️</div>
      <h2 class="heading text-5xl md:text-7xl mb-8 leading-tight">Your next dream trip<br/><span class="text-gold">starts at home.</span></h2>
      <p class="body text-xl mb-12">
        Join the waitlist to receive your personalized "Texas Sweet Spot" report within 24 hours of launch.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#waitlist" class="btn-primary w-full sm:w-auto px-12 py-5 text-lg shadow-gold/20">
          Get My Texas Plan &nbsp; ✈️
        </a>
      </div>
      <p class="mt-8 text-slate-500 text-sm">
        Limited early access slots remaining for April 2026.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════ FOOTER ═══════════════════════════ -->
  <footer class="py-16 bg-tcf-navy-deep border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-10">
        <div class="flex items-center gap-4">
          <span class="text-3xl grayscale">✈️</span>
          <div class="flex flex-col text-left leading-tight">
            <span class="label text-xs tracking-widest text-gold-solid mb-0.5">Texas</span>
            <span class="font-black text-sm uppercase">Cheap Flights</span>
          </div>
        </div>
        
        <div class="flex gap-8 text-slate-500 text-xs font-semibold uppercase tracking-widest">
          <a href="#" class="hover:text-gold transition-colors">Privacy</a>
          <a href="#" class="hover:text-gold transition-colors">Terms</a>
          <a href="#" class="hover:text-gold transition-colors">Affiliate Policy</a>
        </div>

        <p class="text-slate-600 text-[10px] max-w-xs text-center md:text-right">
          © 2026 Texas Cheap Flights. Travel responsibly. Credit card strategies involve risk; always pay in full.
        </p>
      </div>
    </div>
  </footer>

  <script>
    const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
    const successState = document.getElementById('success-state') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const referralLink = document.getElementById('referral-link') as HTMLInputElement | null;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const airportInput = document.getElementById('airport') as HTMLSelectElement;

      if (!emailInput?.value || !airportInput?.value) return;

      if (submitBtn) {
        submitBtn.innerHTML = '<span class="animate-pulse">Building your plan...</span>';
        submitBtn.disabled = true;
      }

      // Simulate API
      await new Promise(r => setTimeout(r, 1500));

      if (form) form.style.display = 'none';
      if (successState) successState.classList.remove('hidden');

      // Generate random ref code
      const refCode = airportInput.value + Math.random().toString(36).substring(2,7).toUpperCase();
      if (referralLink) referralLink.value = `txflights.co/ref/${refCode}`;
    });

    copyBtn?.addEventListener('click', () => {
      if (referralLink) {
        navigator.clipboard.writeText(referralLink.value);
        copyBtn.textContent = 'Copied!';
        setTimeout(() => copyBtn.textContent = 'Copy', 2000);
      }
    });

    // Observer for fade-up animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('anim-fade-up');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.anim-fade-up').forEach(el => observer.observe(el));
  </script>

</body>
</html>
