---
import '../styles/global.css';
import GlobalNav from '../components/GlobalNav.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import { supabase } from '../lib/supabase';
import { curateShowcaseDeals, mapDealToShowcaseCard } from '../lib/deal-showcase';

// Fetch recent deals from Supabase for the live ticker
let RECENT_TICKER: { id: string; text: string; type: string }[] = [];
try {
  const { data: dbDeals } = await supabase
    .from('deals')
    .select('id, origin, destination, price, airline, sent_at, created_at, deal_type, score')
    .not('sent_at', 'is', null)
    .gte('score', 7)
    .order('sent_at', { ascending: false })
    .limit(40);

  if (dbDeals && dbDeals.length > 0) {
    RECENT_TICKER = curateShowcaseDeals(dbDeals, { limit: 10, maxPerAirline: 2, maxPerOrigin: 2 }).map(d => {
      const dealDate = d.sent_at || d.created_at;
      const daysAgo = Math.floor((Date.now() - new Date(dealDate).getTime()) / (1000 * 60 * 60 * 24));
      const age = daysAgo === 0 ? 'Today' : daysAgo === 1 ? '1d ago' : `${daysAgo}d ago`;
      const type = (d.deal_type === 'error_fare' || d.score >= 9) ? 'glitch' : 'sweetspot';
      const priceText = d.price ? `$${d.price}` : 'Points Deal';
      return { id: d.id, text: `${d.origin} to ${d.destination}: ${priceText} (${age})`, type };
    });
  }
} catch (_) {}

// Fallback: use hardcoded examples if no real data in DB yet
const TICKER_ITEMS = RECENT_TICKER.length > 0 ? RECENT_TICKER : [
  { text: "MFE to Orlando: $95 (Found 2h ago)", type: "glitch" },
  { text: "SAT to Denver: $148 (Found 14h ago)", type: "sweetspot" },
  { text: "CRP to Grand Canyon: $160 (Found 1d ago)", type: "glitch" },
  { text: "AUS to Tokyo: 70k Pts (Found 2d ago)", type: "sweetspot" },
  { text: "HRL to Cancun: $290 (Found 3d ago)", type: "glitch" },
  { text: "DFW to London: $450 (Found 4d ago)", type: "sweetspot" },
  { text: "LRD to Vegas: $118 (Found 1w ago)", type: "glitch" },
];

const TX_AIRPORTS = [
  { code: 'MFE', city: 'McAllen' },
  { code: 'HRL', city: 'Harlingen' },
  { code: 'BRO', city: 'Brownsville' },
  { code: 'LRD', city: 'Laredo' },
  { code: 'CRP', city: 'Corpus Christi' },
  { code: 'MAF', city: 'Midland / Odessa' },
  { code: 'SAT', city: 'San Antonio' },
  { code: 'AUS', city: 'Austin' },
  { code: 'IAH', city: 'Houston (Bush)' },
  { code: 'HOU', city: 'Houston (Hobby)' },
  { code: 'DFW', city: 'Dallas / Fort Worth' },
  { code: 'DAL', city: 'Dallas (Love Field)' },
  { code: 'ELP', city: 'El Paso' },
  { code: 'LBB', city: 'Lubbock' },
  { code: 'AMA', city: 'Amarillo' },
  { code: 'GRK', city: 'Killeen' },
  { code: 'TYR', city: 'Tyler' },
  { code: 'GGG', city: 'Longview' },
  { code: 'ABI', city: 'Abilene' },
];

const PAIN_QUOTES = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-frown"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>`,
    text: '"I have 60,000 Chase points and zero idea what they\'re worth."'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-circle"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`,
    text: '"Every time I search from Laredo, flights are $800. There has to be a better way."'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    text: '"I saw a $290 roundtrip to Cancun from Harlingen. By the time I found it, it was $1,100. I had no idea those windows existed."'
  },
];

const HOW_IT_WORKS = [
  {
    step: '01',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
    title: 'Pick your Texas airport',
    desc: 'From MFE to DFW, we watch for pricing mistakes and typos specific to your airport — not generic deals built for JFK flyers.'
  },
  {
    step: '02',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    title: 'We catch the deal',
    desc: 'We track error fares (pricing mistakes that slash a fare for a few hours) and point deals (miles that go further from Texas than the price chart suggests). You get the alert the second one shows up.'
  },
  {
    step: '03',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>`,
    title: 'We double-check it, then you move fast.',
    desc: 'Error fares can close within hours, but every alert is reviewed by a person before it reaches the list. You get the route, the price, and the booking link in one place.'
  },
];

const HEDGING_TRIPS = [
  { route: 'MFE → DFW → London', status: 'Locked in ✅', color: 'var(--tcf-success)' },
  { route: 'AUS → Tokyo via ANA', status: 'Backup found ⚡', color: 'var(--tcf-caution)' },
  { route: 'DFW → Cancun award', status: 'Refundable 🛡️', color: 'var(--tcf-success)' },
];

const AIRPORTS = [
  { code: 'MFE', city: 'McAllen', hot: true },
  { code: 'HRL', city: 'Harlingen', hot: true },
  { code: 'BRO', city: 'Brownsville', hot: true },
  { code: 'LRD', city: 'Laredo', hot: true },
  { code: 'CRP', city: 'Corpus Christi', hot: true },
  { code: 'MAF', city: 'Midland', hot: false },
  { code: 'SAT', city: 'San Antonio', hot: false },
  { code: 'AUS', city: 'Austin', hot: false },
  { code: 'IAH', city: 'Houston', hot: false },
  { code: 'HOU', city: 'Houston', hot: false },
  { code: 'DFW', city: 'Dallas', hot: false },
  { code: 'DAL', city: 'Dallas', hot: false },
  { code: 'ELP', city: 'El Paso', hot: false },
  { code: 'LBB', city: 'Lubbock', hot: false },
  { code: 'AMA', city: 'Amarillo', hot: false },
  { code: 'GRK', city: 'Killeen', hot: false },
  { code: 'TYR', city: 'Tyler', hot: false },
  { code: 'GGG', city: 'Longview', hot: false },
  { code: 'ABI', city: 'Abilene', hot: false },
];

const ETHICS = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>`,
    text: 'Never push you into debt'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
    text: 'We earn via affiliates only'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.5 9 11.5"/></svg>`,
    text: 'We double-check before you redeem'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
    text: 'Your airport. Your plan.'
  },
];

let DB_FEATURED_DEALS: any[] = [];
try {
  const { data: featuredData } = await supabase
    .from('deals')
    .select('id, origin, destination, price, airline, deal_type, score')
    .not('sent_at', 'is', null)
    .gte('score', 7)
    .order('sent_at', { ascending: false })
    .limit(40);

  if (featuredData && featuredData.length > 0) {
    DB_FEATURED_DEALS = curateShowcaseDeals(featuredData, { limit: 4, maxPerAirline: 1, maxPerOrigin: 1 }).map(mapDealToShowcaseCard);
  }
} catch (_) {}

const FEATURED_DEALS = DB_FEATURED_DEALS.length > 0 ? DB_FEATURED_DEALS : [
  {
    type: 'cash_glitch',
    origin: 'MFE',
    dest: 'Orlando',
    glitch_price: '$95',
    normal_price: '$450',
    airline: 'American',
    lifespan: '4h',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
  },
  {
    type: 'cash_glitch',
    origin: 'SAT',
    dest: 'London',
    glitch_price: '$420',
    normal_price: '$1,200',
    airline: 'British Airways',
    lifespan: '12h',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
  },
  {
    type: 'award_sweet_spot',
    origin: 'LRD',
    dest: 'Cancun',
    points: '15,000',
    cash: '$580',
    airline: 'United',
    alliance: 'Star Alliance',
    tags: ['Regional Shortcut', 'Zero Fees'],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`
  },
  {
    type: 'cash_glitch',
    origin: 'HRL',
    dest: 'Cancun',
    glitch_price: '$290',
    normal_price: '$1,100',
    airline: 'United',
    lifespan: '24h',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
  }
];

let subscriberCount: number | null = null;
let archivedAlertCount: number | null = null;
try {
  const [subscriberRes, dealRes] = await Promise.all([
    supabase
      .from('subscribers')
      .select('*', { count: 'exact', head: true })
      .eq('active', true),
    supabase
      .from('deals')
      .select('*', { count: 'exact', head: true })
      .not('sent_at', 'is', null)
      .gte('score', 7),
  ]);
  subscriberCount = subscriberRes.count ?? null;
  archivedAlertCount = dealRes.count ?? null;
} catch (_) {}

const proofLine = subscriberCount !== null && archivedAlertCount !== null
  ? `${subscriberCount} founding subscribers · ${archivedAlertCount} archived alerts`
  : 'Founding subscriber list · Public deal archive';

// (Ticker data is now fetched live from Supabase above — see TICKER_ITEMS)
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#fffdf7" />
  <title>Texas Cheap Flights — Error Fares & Award Deal Alerts</title>
  <meta name="description" content="Flight deal alerts for Texas travelers. We watch for error fares and point deals from 19 Texas airports, then alert you before the window closes." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://texascheapflights.com/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Texas Cheap Flights — Error Fares & Award Deal Alerts" />
  <meta name="twitter:description" content="We watch for error fares and point deals from 19 Texas airports. Get the alert before the window closes." />
  <meta name="twitter:image" content="https://texascheapflights.com/og-image.png" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>" />
  <link rel="canonical" href="https://texascheapflights.com/" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://texascheapflights.com/#organization",
        "name": "Texas Cheap Flights",
        "url": "https://texascheapflights.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://texascheapflights.com/logo-light.png"
        },
        "description": "Flight deal alerts for Texas travelers. Watches for error fares and award sweet spots departing from Texas airports."
      },
      {
        "@type": "WebSite",
        "@id": "https://texascheapflights.com/#website",
        "url": "https://texascheapflights.com",
        "name": "Texas Cheap Flights",
        "publisher": {
          "@id": "https://texascheapflights.com/#organization"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://texascheapflights.com/past-deals?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://texascheapflights.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How is this different from Scott's Cheap Flights or Going?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Generic deal sites focus on huge hubs like JFK or LAX. We are built specifically for Texas. We track regional feeders like McAllen, Laredo, and Harlingen, and we include award sweet spots (points) which most other sites ignore."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to live in a major city like Dallas or Houston?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. In fact, we built this because regional Texas airports are often overlooked. We monitor 19 Texas airports including MFE, LRD, BRO, CRP, and ELP."
            }
          },
          {
            "@type": "Question",
            "name": "What is an 'Error Fare'?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "An error fare is when an airline's pricing system makes a mistake, sometimes selling international tickets for 50-90% off. These windows usually close within hours, which is why we send alerts immediately."
            }
          }
        ]
      }
    ]
  }
  </script>
  <!-- Fonts (async — non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://api.fontshare.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap">
  </noscript>
</head>

<body class="font-body scroll-smooth selection:bg-tcf-gold/30 selection:text-tcf-ink">

  <GlobalNav activePage="home" />

  <main>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="hero-gradient relative min-h-screen flex flex-col items-center justify-center px-6 pt-32 pb-20 overflow-hidden text-center">
    <div class="starfield"></div>

    <!-- Ambient warmth -->
    <div class="absolute top-1/4 -right-20 w-[500px] h-[500px] bg-tcf-aviation-blue/10 blur-[150px] rounded-full"></div>
    <div class="absolute bottom-1/4 -left-20 w-[500px] h-[500px] bg-tcf-gold/10 blur-[150px] rounded-full"></div>

    <div class="z-content max-w-5xl mx-auto w-full flex flex-col items-center">

      <!-- Badge -->
      <div class="anim-fade-up delay-1 inline-flex items-center gap-3 badge-gold mb-10 backdrop-blur-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tcf-gold-deep opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-tcf-gold-deep"></span>
        </span>
        Live scanning Dallas, Houston, and 17 more Texas airports
      </div>

      <!-- Hero headline -->
      <h1 class="anim-fade-up delay-2 mb-8 text-tcf-ink w-full max-w-4xl" style="font-size: clamp(2.5rem, 8vw, 5.5rem);">
        Airlines make pricing mistakes.<br/>
        We make sure Texas <span class="text-gold">hears about it first.</span>
      </h1>

      <!-- Subheadline -->
      <p class="anim-fade-up delay-3 max-w-2xl text-xl mb-12 text-tcf-ink-muted leading-relaxed font-body">
        We watch for two kinds of deals: <span class="text-tcf-ink font-semibold">error fares</span>, where a pricing mistake slashes a fare for a few hours, and <span class="text-tcf-ink font-semibold">point deals</span>, where your miles go further than usual from a Texas airport. Every alert is checked by a person before it reaches you.
      </p>

      <div class="anim-fade-up delay-3 mb-10 grid w-full max-w-3xl grid-cols-1 gap-3 text-left sm:grid-cols-3">
        <div class="rounded-2xl border border-tcf-ink/10 bg-white/60 px-5 py-4 backdrop-blur-sm">
          <p class="text-2xl font-black text-tcf-ink">19</p>
          <p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-tcf-ink-muted">Texas airports watched</p>
        </div>
        <div class="rounded-2xl border border-tcf-gold/25 bg-tcf-gold/[0.08] px-5 py-4 backdrop-blur-sm">
          <p class="text-2xl font-black text-tcf-gold-deep">{archivedAlertCount ?? '—'}</p>
          <p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-tcf-ink-muted">Verified alerts archived</p>
        </div>
        <div class="rounded-2xl border border-tcf-aviation-blue/25 bg-tcf-aviation-blue/[0.08] px-5 py-4 backdrop-blur-sm">
          <p class="text-2xl font-black text-tcf-sky-deep">{subscriberCount ?? '—'}</p>
          <p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-tcf-ink-muted">Active email subscribers</p>
        </div>
      </div>

      <!-- WAITLIST FORM -->
      <div class="anim-fade-up delay-4 w-full max-w-lg scroll-mt-32" id="waitlist">
        <div class="liquid-glass p-8 md:p-10 rounded-[2.5rem] shadow-xl relative">
          <div class="absolute -top-10 -left-10 w-20 h-20 bg-tcf-aviation-blue/15 blur-2xl rounded-full"></div>

          <form id="waitlist-form" data-tcf-form="homepage_waitlist" class="flex flex-col gap-6 relative">
            <div class="flex flex-col gap-2.5 text-left">
              <label for="airport" class="text-tcf-ink-muted text-xs font-bold uppercase tracking-widest pl-1">Home Airport</label>
              <select id="airport" name="airport" required class="input appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2352616f%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20class%3D%22lucide%20lucide-chevron-down%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25em] bg-[right_1.25rem_center] bg-no-repeat">
                <option value="" disabled selected>Select your departure airport...</option>
                {TX_AIRPORTS.map(a => (
                  <option value={a.code}>{a.city} ({a.code})</option>
                ))}
              </select>
            </div>

            <div class="flex flex-col gap-2.5 text-left">
              <label for="email" class="text-tcf-ink-muted text-xs font-bold uppercase tracking-widest pl-1">Email Address</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="you@adventure.com"
                class="input"
              />
            </div>

            <button type="submit" id="submit-btn" data-tcf-event="cta_clicked" data-tcf-location="homepage_waitlist" class="btn-primary w-full mt-2 text-lg">
              Alert Me When Deals Drop
            </button>

            <div class="flex items-center justify-center gap-4 text-xs text-tcf-ink-muted">
              <div class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-tcf-success"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
