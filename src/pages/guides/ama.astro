---
import '../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import GlobalFooter from '../../components/GlobalFooter.astro';
import AirportGuide from '../../components/AirportGuide.astro';

const airportCode = "AMA";
const city = "Amarillo";
const airportName = "Rick Husband Amarillo International";

const sweetSpots = [
  { 
    destination: "Dallas (DFW/DAL)", 
    reason: "Southwest and American maintain high-frequency service here. We catch 'Short-Haul Slips' where pricing drops to $80 roundtrip for weekend travelers, beating the 6-hour drive easily." 
  },
  { 
    destination: "Denver (DEN)", 
    reason: "United's presence at AMA often results in price matches for regional sales, dropping DEN connections to sub-$140 roundtrip." 
  },
  { 
    destination: "Austin (AUS)", 
    reason: "Intra-Texas routes are prone to 'Inventory Dumping' where Southwest sells leftover seats for 4.5k-7.5k points during off-peak weeks." 
  }
];

const description = `Rick Husband Amarillo International (AMA) is the gateway to the Texas Panhandle. Because Amarillo is a major center for the agriculture and energy sectors, it is dominated by business travel during the week. Our AI Scout specializes in catching the 'Weekend Trade Gaps' where legacy carriers slash prices to fill seats that would otherwise fly empty.`;

const parkingTips = "AMA offers some of the easiest parking in Texas. The main lot is just steps from the terminal. For the best value, look for the long-term parking area which is significantly cheaper for multi-day trips. Pro-tip: AMA is small enough that you can arrive 45 minutes before departure and still have time for a coffee.";

const tsaWaitStatus = "Typically extremely fast, rarely exceeding 5-10 minutes. However, give yourself a bit more time during major ranching or livestock show weeks when the terminal volume can surge with travelers from all over the country.";

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AMA Cheap Flights | Panhandle Deal Guide | TCF</title>
  <meta name="description" content="Find cheap flights from Amarillo with AMA-specific tips for Panhandle business travel, weekend seat gaps, parking, TSA timing, and fare alerts." />
  <link rel="canonical" href="https://texascheapflights.com/guides/ama" />
</head>
<body class="bg-navy-deep text-white selection:bg-gold/30">
  <GlobalNav activePage="guides" />

  <main class="max-w-7xl mx-auto px-6 pt-32 pb-24">
    <div class="mb-12">
      <a href="/past-deals" class="text-slate-500 hover:text-gold text-sm font-bold flex items-center gap-2 transition-colors mb-4">
        &larr; Back to Deal Archive
      </a>
      <h2 class="text-sm font-black text-gold uppercase tracking-[0.3em] mb-2">Regional Intelligence</h2>
      <p class="text-slate-400 max-w-2xl">
        Amarillo flyers are often told to drive to OKC or DFW for 'better' deals. We're here to prove that the best deals are right here in the Panhandle if you know when to look.
      </p>
    </div>

    <AirportGuide 
      airportCode={airportCode}
      airportName={airportName}
      city={city}
      description={description}
      sweetSpots={sweetSpots}
      parkingTips={parkingTips}
      tsaWaitStatus={tsaWaitStatus}
    />

    <!-- SEO Content Section -->
    <section class="mt-24 max-w-3xl mx-auto">
      <article class="prose prose-invert lg:prose-xl">
        <h2 class="text-3xl font-black text-white italic">The Amarillo "Weekend Gap" Strategy</h2>
        <p class="text-slate-400">
          Flight pricing at <strong>AMA</strong> is driven by high-yield business travel. This creates a fascinating opportunity on the weekends. When the business-travel week ends, the algorithms are left with unsold inventory that they have to dump.
        </p>
        <p class="text-slate-400">
          Our AI Scout specifically looks for these <strong>'Inventory Slips'</strong> — moments where a flight to a major hub like DFW or DEN drops to a fraction of its normal price to attract leisure travelers.
        </p>
        
        <div class="my-12 p-8 bg-gold/5 border-l-4 border-gold rounded-r-2xl italic text-lg text-gold/80 leading-relaxed">
          "The best way to save in Amarillo isn't just about picking the cheapest airline; it's about catching the legacy carriers when they've lost their business travelers for the weekend."
        </div>

        <h3 class="text-2xl font-black text-white">Get AMA Alerts</h3>
        <p class="text-slate-400">
          Subscribe to our AMA-specific alert list. We monitor كل Southwest, American and United route from Amarillo every hour. When a price hits the "Unicorn" threshold, you'll be the first to know.
        </p>
      </article>
    </section>

        <!-- Footer CTA -->
    <section class="mt-24 p-12 bg-gradient-to-br from-navy-mid to-navy-deep border border-white/10 rounded-[2.5rem] text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1436491865332-7a61a1082e12?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-5"></div>
      <div class="relative z-10">
        <h2 class="text-3xl font-black text-white mb-4 italic">Ready to find your next AMA glitch?</h2>
        <p class="text-slate-400 mb-8 max-w-xl mx-auto">
          Join the savvy travelers from Amarillo who get alerts before the algorithms catch up.
        </p>
        <a href="/#waitlist" class="btn-primary shadow-[0_20px_40px_rgba(212,168,67,0.2)]">
          Join the waitlist
        </a>
      </div>
    </section>
  </main>

  <GlobalFooter />

</body>
</html>
