---
import '../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import GlobalFooter from '../../components/GlobalFooter.astro';
import AirportGuide from '../../components/AirportGuide.astro';
import { AIRPORT_ROUTE_SEARCH, BROWNSVILLE_ROUTES } from '../../data/airport-route-search';

const airportCode = "BRO";
const city = "Brownsville";
const airportName = "Brownsville South Padre Island International";

const sweetSpots = BROWNSVILLE_ROUTES.map((route) => ({
  destination: `${route.destination} (${route.code})`,
  reason: route.detail,
}));

const description = "Brownsville South Padre Island International Airport serves Brownsville and the lower Rio Grande Valley. Check nonstop destinations before choosing your flights.";
const parkingTips = "Check the airport's current parking rates and pickup instructions before you leave.";
const tsaWaitStatus = "Check your airline's recommended arrival time, especially if you're checking bags.";

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Brownsville Airport Guide (BRO) | Routes & South Padre Access</title>
  <meta name="description" content="See where Brownsville airport (BRO) flies nonstop and compare Brownsville, Harlingen, and McAllen for a trip to South Padre Island." />
  <link rel="canonical" href="https://texascheapflights.com/guides/bro" />
</head>
<body class="text-tcf-ink selection:bg-tcf-gold/30">
  <GlobalNav activePage="guides" />

  <main class="max-w-7xl mx-auto px-6 pt-32 pb-24">
    <aside class="mb-10 p-5 rounded-2xl border border-tcf-gold/20 bg-tcf-gold/5">
      <a href="/guides/rio-grande-valley#south-padre" class="font-bold text-tcf-gold-deep underline">
        Flying to South Padre Island? Compare BRO, HRL, and MFE
      </a>
    </aside>

    <AirportGuide 
      heading="Brownsville Airport Guide"
      subheading="Brownsville South Padre Island International (BRO)"
      routesHeading="Nonstop flights from BRO"
      archiveHref="/deals/from/bro"
      airportCode={airportCode}
      airportName={airportName}
      city={city}
      description={description}
      sweetSpots={sweetSpots}
      parkingTips={parkingTips}
      tsaWaitStatus={tsaWaitStatus}
    />

    <section class="mt-12 max-w-3xl mx-auto">
      <h2 class="text-2xl font-black text-tcf-ink mb-3">Check your flight dates</h2>
      <p class="text-tcf-ink-muted mb-4">Flight days can vary by route. Confirm availability with the airline before planning around a nonstop.</p>
      <a href={AIRPORT_ROUTE_SEARCH.BRO?.source} class="text-tcf-gold-deep font-bold underline">Brownsville airport airline list</a>
    </section>

    <section class="mt-24 p-12 bg-tcf-cream border border-tcf-ink/10 rounded-[2.5rem] text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1436491865332-7a61a1082e12?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-10"></div>
      <div class="relative z-10">
        <h2 class="text-3xl font-black text-tcf-ink mb-4 italic">Get Brownsville flight alerts</h2>
        <p class="text-tcf-ink-muted mb-8 max-w-xl mx-auto">
          Choose Brownsville as your home airport when you sign up.
        </p>
        <a href="/#waitlist" class="btn-primary shadow-[0_20px_40px_rgba(212,168,67,0.2)]">
          Join the waitlist
        </a>
      </div>
    </section>
  </main>

  <GlobalFooter />

</body>
</html>
