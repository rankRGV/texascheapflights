---
import '../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import GlobalFooter from '../../components/GlobalFooter.astro';
import { normalizeAirlineName } from '../../lib/airlines';
import { formatSocialTravelDates } from '../../lib/social-travel-dates';
import { supabase } from '../../lib/supabase';

const airports = [
  {
    code: 'BRO', city: 'Brownsville', drive: '30 min',
    transfer: 'Start here for the shortest drive. Check shuttle or private car availability for your arrival.',
  },
  {
    code: 'HRL', city: 'Harlingen', drive: '45–55 min',
    transfer: 'Check Harlingen if its flight times or fares suit you better. Confirm shuttle pickup before booking.',
  },
  {
    code: 'MFE', city: 'McAllen', drive: '90 min',
    transfer: 'Compare the airfare savings against the longer drive and the cost of a rental car or transfer.',
  },
];

const date = new Intl.DateTimeFormat('en-US', { month: '2-digit', day: '2-digit', year: '2-digit', timeZone: 'UTC' });
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 });
const googleFlights = (query: string) => `https://www.google.com/travel/flights?${new URLSearchParams({ q: query })}`;
const groundGuide = 'https://visitsouthpadreisland.com/plan-your-trip/getting-here/';
const transferFaq = 'https://visitsouthpadreisland.com/plan-your-trip/faq/';

const archive = await Promise.all(airports.map(async (airport) => {
  const { data, error } = await supabase.from('deals')
    .select('id, destination, airline, price, travel_dates, sent_at')
    .eq('origin', airport.code)
    .not('sent_at', 'is', null)
    .gt('price', 0)
    .order('sent_at', { ascending: false })
    .limit(3);
  return { ...airport, deals: data ?? [], unavailable: Boolean(error) };
}));

const title = 'Rio Grande Valley Airport Guide | McAllen, Harlingen & Brownsville';
const description = 'Compare McAllen, Harlingen, and Brownsville for flights from the Rio Grande Valley or a trip to South Padre Island. See airport transfer estimates and past flight deals.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://texascheapflights.com/guides/rio-grande-valley" />
  </head>
  <body class="bg-tcf-paper text-tcf-ink">
    <GlobalNav activePage="guides" />
    <main>
      <header class="border-b border-tcf-ink/10 bg-tcf-cream px-6 pb-14 pt-28 sm:pb-20 sm:pt-36">
        <div class="mx-auto max-w-6xl">
          <a href="/guides" class="text-sm font-bold text-tcf-sky-deep underline-offset-4 hover:underline">← Texas airport guides</a>
          <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.03] tracking-tight sm:text-6xl lg:text-7xl">Which Rio Grande Valley airport should you use?</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tcf-ink-muted">Compare McAllen, Harlingen, and Brownsville for flights from the Valley or a trip to South Padre Island.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary" href="#departures" data-tcf-event="valley_hub_direction" data-tcf-location="valley_hub_departures">Flying from the Valley</a>
            <a class="inline-flex min-h-12 items-center rounded-full border border-tcf-ink/25 px-5 py-3 font-bold hover:bg-white" href="#south-padre" data-tcf-event="valley_hub_direction" data-tcf-location="valley_hub_arrivals">Flying to South Padre</a>
          </div>
        </div>
      </header>

      <section id="departures" aria-labelledby="departure-title" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-14 sm:py-20">
        <div class="max-w-2xl">
          <h2 id="departure-title" class="text-3xl font-black tracking-tight sm:text-5xl">Flying from the Valley</h2>
          <p class="mt-4 leading-relaxed text-tcf-ink-muted">Start with your nearest airport, then check the same travel dates from the other two. These are past prices from our archive. Use the flight search links for current prices and availability.</p>
        </div>
        <div class="mt-8 grid gap-4 lg:grid-cols-3">
          {archive.map(({ code, city, deals, unavailable }) => (
            <article class="flex flex-col rounded-3xl border border-tcf-ink/10 bg-white p-6">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-2xl font-black">{city}</h3>
                <span class="rounded-lg bg-tcf-cream px-2.5 py-1 text-sm font-black text-tcf-ink">{code}</span>
              </div>
              <div class="mt-4 grow">
                {unavailable ? <p class="py-4 text-sm text-tcf-ink-muted">Past deals are temporarily unavailable.</p> : deals.length === 0 ? <p class="py-4 text-sm text-tcf-ink-muted">No archived cash fares for this airport yet.</p> : (
                  <ul class="divide-y divide-tcf-ink/10" aria-label={`Past flight deals from ${city}`}>
                    {deals.map((deal) => (
                      <li class="py-3">
                        <a href={`/deal/${deal.id}`} class="flex items-start justify-between gap-3 font-bold hover:underline" data-tcf-event="valley_hub_archive_click" data-tcf-location="valley_hub_departures" data-airport={code}>
                          <span>{deal.destination}</span>
                          <span class="shrink-0 text-tcf-sky-deep">{money.format(deal.price)}</span>
                        </a>
                        <p class="mt-1 text-xs text-tcf-ink-muted">{normalizeAirlineName(deal.airline)} · Found <time datetime={deal.sent_at}>{date.format(new Date(deal.sent_at))}</time></p>
                        {deal.travel_dates && <p class="mt-1 text-xs text-tcf-ink-muted">Travel dates: {formatSocialTravelDates(deal.travel_dates)}</p>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <a href={googleFlights(`Flights from ${code}`)} target="_blank" rel="noopener noreferrer" class="mt-5 rounded-xl bg-tcf-sky-soft px-4 py-3 text-center text-sm font-bold text-tcf-sky-deep hover:underline" data-tcf-event="valley_hub_search_click" data-tcf-location="valley_hub_departures" data-airport={code}>Check flights from {code} ↗</a>
              <div class="mt-4 flex flex-wrap justify-between gap-x-4 gap-y-2 text-sm font-bold">
                <a class="underline underline-offset-4" href={`/guides/${code.toLowerCase()}`}>Airport guide</a>
                <a class="text-tcf-sky-deep underline underline-offset-4" href={`/?source=valley-hub&airport=${code}#waitlist`} data-tcf-event="valley_hub_signup_click" data-tcf-location="valley_hub_departures" data-airport={code}>Get {code} alerts</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="south-padre" aria-labelledby="arrival-title" class="scroll-mt-24 border-t border-tcf-ink/10 bg-tcf-cream px-6 py-14 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-2xl">
            <h2 id="arrival-title" class="text-3xl font-black tracking-tight sm:text-5xl">Flying to South Padre Island</h2>
            <p class="mt-4 leading-relaxed text-tcf-ink-muted">Compare the cost and time of the whole trip, including the ride from the airport to the island.</p>
          </div>
          <ul class="mt-8 divide-y divide-tcf-ink/10 overflow-hidden rounded-3xl border border-tcf-ink/10 bg-white">
            {airports.map(({ code, city, drive, transfer }) => (
              <li class="grid gap-3 p-5 sm:grid-cols-[1fr_1.5fr_auto] sm:items-center sm:gap-5 sm:p-6">
                <div>
                  <h3 class="text-lg font-black">{city} ({code})</h3>
                  <p class="mt-1 text-sm font-bold text-tcf-sky-deep">About {drive} by car</p>
                </div>
                <p class="text-sm leading-relaxed text-tcf-ink-muted">{transfer}</p>
                <a href={googleFlights(`Flights to ${code}`)} target="_blank" rel="noopener noreferrer" class="w-fit text-sm font-bold text-tcf-sky-deep underline underline-offset-4" data-tcf-event="valley_hub_search_click" data-tcf-location="valley_hub_arrivals" data-airport={code}>Check flights to {code} ↗</a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-tcf-ink-muted">Drive times are estimates and vary with traffic. Sources: <a href={groundGuide} class="underline underline-offset-4">South Padre Island transportation guide</a> and <a href={transferFaq} class="underline underline-offset-4">visitor FAQ</a>.</p>
        </div>
      </section>
    </main>
    <GlobalFooter />
  </body>
</html>
