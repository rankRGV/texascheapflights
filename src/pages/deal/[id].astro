---
import '../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import { supabase } from '../../lib/supabase';
import { normalizeAirlineName } from '../../lib/airlines';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/past-deals');
}

// Fetch the specific deal
const { data: deal, error } = await supabase
  .from('deals')
  .select('*')
  .eq('id', id)
  .not('sent_at', 'is', null)
  .single();

if (error || !deal) {
  return Astro.redirect('/past-deals');
}

const priceDisplay = deal.price ? `$${deal.price}` : 'Points Deal';
const normalizedAirline = normalizeAirlineName(deal.airline);
const title = `${priceDisplay} Flight from ${deal.origin} to ${deal.destination} on ${normalizedAirline || 'Major Airline'} | Texas Cheap Flights`;
const description = `Scouted from ${deal.origin}: ${normalizedAirline ? normalizedAirline + ' flight to ' : ''}${deal.destination} for ${priceDisplay}. ${deal.travel_dates ? 'Travel dates: ' + deal.travel_dates : ''}. Exclusive Texas deal alert.`;
const ogImage = 'https://texascheapflights.com/og-image.png';
const bookingLink = deal.booking_link || `https://www.google.com/travel/flights?q=Flights+to+${encodeURIComponent(deal.destination)}+from+${encodeURIComponent(deal.origin)}`;

// Structured Data (JSON-LD)
const dealSentAt = new Date(deal.sent_at || deal.created_at);
const priceValidUntil = new Date(dealSentAt.getTime() + 48 * 60 * 60 * 1000).toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristTrip",
      "@id": `${Astro.url.href}#deal`,
      "name": `${priceDisplay} Flight: ${deal.origin} to ${deal.destination}`,
      "description": description,
      "image": ogImage,
      "provider": {
        "@type": "Organization",
        "name": "Texas Cheap Flights",
        "url": "https://texascheapflights.com"
      },
      "itinerary": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": { "@type": "Airport", "name": deal.origin, "iataCode": deal.origin }
          },
          {
            "@type": "ListItem",
            "position": 2,
            "item": { "@type": "Airport", "name": deal.destination, "iataCode": deal.destination }
          }
        ]
      },
      "offers": {
        "@type": "Offer",
        "price": deal.price || "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/OutOfStock",
        "priceValidUntil": priceValidUntil,
        "url": Astro.url.href,
        "validFrom": deal.sent_at || deal.created_at
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Texas Cheap Flights",
          "item": "https://texascheapflights.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Past Deals",
          "item": "https://texascheapflights.com/past-deals"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${deal.origin} to ${deal.destination}`,
          "item": Astro.url.href
        }
      ]
    }
  ]
};

// Related deals from same origin
const { data: relatedDeals } = await supabase
  .from('deals')
  .select('id, origin, destination, price, deal_type, score, airline')
  .eq('origin', deal.origin)
  .neq('id', id)
  .not('sent_at', 'is', null)
  .order('sent_at', { ascending: false })
  .limit(3);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="canonical" href={`https://texascheapflights.com/deal/${id}`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Satoshi:wght@400;500;700;900&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="text-tcf-ink min-h-screen" data-tcf-deal-id={deal.id} data-origin={deal.origin} data-destination={deal.destination} data-airline={normalizedAirline} data-price={deal.price ?? ''}>

  <GlobalNav activePage="past-deals" />

  <main class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      
      <div class="mb-8">
        <a href="/past-deals" class="text-tcf-gold-deep hover:underline text-sm font-bold uppercase tracking-wider">← Back to Archive</a>
      </div>

      <div class="rounded-[2.5rem] border border-tcf-ink/10 bg-tcf-ink/5 overflow-hidden shadow-2xl">
        <!-- Deal Card Image -->
        <div class="aspect-[1200/630] w-full bg-slate-900 relative">
            <img src={ogImage} alt={title} class="w-full h-full object-cover" />
        </div>

        <div class="p-8 md:p-12">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
                <div>
                    <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-2">
                        {deal.origin} <span class="text-tcf-ink-muted font-normal">→</span> {deal.destination}
                    </h1>
                    <p class="text-xl text-tcf-ink-muted font-body">
                        {normalizedAirline} · {deal.travel_dates}
                    </p>
                </div>
                <div class="text-left md:text-right">
                    {deal.price ? (
                        <div class="text-5xl md:text-7xl font-black text-tcf-gold-deep tracking-tighter">${deal.price}</div>
                    ) : (
                        <div class="text-3xl font-black text-sky-400">Points Deal</div>
                    )}
                    <p class="text-xs text-tcf-ink-muted uppercase tracking-[0.2em] mt-1">Roundtrip Total</p>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-8 mb-12">
                <div class="p-6 rounded-2xl bg-tcf-ink/5 border border-tcf-ink/10">
                    <h3 class="text-xs font-black text-tcf-ink-muted uppercase tracking-widest mb-4">Market Context</h3>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-tcf-ink-muted">AI Scout Score</span>
                            <span class={`font-black ${deal.score >= 8 ? 'text-green-400' : 'text-amber-400'}`}>{deal.score}/10</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-tcf-ink-muted">Lifespan</span>
                            <span class="text-sm font-bold text-tcf-ink">~24-48 hours</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-tcf-ink-muted">Status</span>
                            <span class="text-xs font-black text-tcf-gold-deep uppercase tracking-wider">Expired or Dynamic</span>
                        </div>
                    </div>
                </div>

                <div class="p-6 rounded-2xl bg-tcf-gold/10 border border-tcf-gold/20 flex flex-col justify-center">
                    <p class="text-sm text-tcf-ink-muted mb-4 leading-relaxed">
                        Deals like this appear and disappear in hours. To get alerted the second our scout finds the next one:
                    </p>
                    <div class="grid gap-3">
                      <a href={bookingLink} target="_blank" rel="noopener noreferrer" data-tcf-booking data-deal-id={deal.id} data-origin={deal.origin} data-destination={deal.destination} class="btn-primary w-full py-4 text-center text-sm no-underline font-black uppercase tracking-widest" style="background: var(--tcf-gold); color: #050a14;">
                        Check this route
                      </a>
                      <a href="/#waitlist" data-tcf-event="cta_clicked" data-tcf-location="deal_detail" data-tcf-label="Join the Scout List" class="text-center text-xs font-black uppercase tracking-widest text-tcf-ink-muted hover:text-tcf-ink no-underline">
                        Get the next alert
                      </a>
                    </div>
                </div>
            </div>

            <div class="mb-12">
                <h2 class="text-xl font-black text-tcf-ink uppercase tracking-wider mb-6">Deal Breakdown</h2>
                <div class="space-y-6 text-tcf-ink-muted font-body leading-relaxed">
                    <p>
                        This alert was triggered because the price for <strong class="text-tcf-ink" data-ai-key="destination">{deal.destination}</strong> stood out against our live scout thresholds for departures from <strong class="text-tcf-ink" data-ai-key="origin">{deal.origin}</strong> and cleared the send threshold for Texas subscribers.
                    </p>
                    <div class="grid gap-4">
                        <div class="p-6 rounded-2xl bg-tcf-ink/5 border border-tcf-ink/10 flex gap-4 items-start">
                            <div class="w-10 h-10 rounded-full bg-tcf-aviation-blue/10 flex items-center justify-center text-tcf-aviation-blue flex-shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.5 9 11.5"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-tcf-ink mb-1 uppercase tracking-tight">Verified Route</p>
                                <p class="text-xs text-tcf-ink-muted">Operated by <span data-ai-key="airline" class="text-tcf-ink-muted">{normalizedAirline || 'Major Carrier'}</span>. It made the feed because it cleared our current value and route-quality thresholds, not just because it was cheap in raw dollars.</p>
                            </div>
                        </div>
                        <div class="p-6 rounded-2xl bg-tcf-ink/5 border border-tcf-ink/10 flex gap-4 items-start">
                            <div class="w-10 h-10 rounded-full bg-tcf-gold/10 flex items-center justify-center text-tcf-gold-deep flex-shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-tcf-ink mb-1 uppercase tracking-tight">Travel Window</p>
                                <p class="text-xs text-tcf-ink-muted" data-ai-key="travel_dates">{deal.travel_dates || 'Dates vary, check availability.'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <p class="text-xs text-tcf-ink-muted font-body">
                    Scouted on <time datetime={new Date(deal.sent_at || deal.created_at).toISOString()} data-ai-key="scout_date">{new Date(deal.sent_at || deal.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>.
                    Prices are subject to airline availability.
                </p>
            </div>
        </div>
      </div>
    </div>
  </main>

  <!-- ══ RELATED DEALS ══ -->
  {relatedDeals && relatedDeals.length > 0 && (
    <section class="border-t border-tcf-ink/10 px-6 py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xs font-black text-tcf-ink-muted uppercase tracking-widest mb-6">More deals from {deal.origin}</h2>
        <div class="grid gap-3">
          {relatedDeals.map(r => (
            <a href={`/deal/${r.id}`} class="flex justify-between items-center p-4 rounded-2xl liquid-glass border border-tcf-ink/10 hover:border-tcf-gold/30 transition-all no-underline group">
              <div>
                <span class="text-sm font-black text-tcf-ink group-hover:text-tcf-gold-deep transition-colors">{r.origin} → {r.destination}</span>
                <span class="text-xs text-tcf-ink-muted ml-3">{normalizeAirlineName(r.airline)}</span>
              </div>
              <span class="text-sm font-black text-tcf-gold-deep">{r.price ? `$${r.price}` : 'Points'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ HUB LINK ══ -->
  <section class="border-t border-tcf-ink/10 px-6 py-10 text-center">
    <p class="text-sm text-tcf-ink-muted mb-3">More deals departing this airport:</p>
    <a href={`/deals/from/${deal.origin.toLowerCase()}`} class="inline-flex items-center gap-2 text-tcf-aviation-blue hover:underline font-bold text-sm no-underline hover:text-tcf-ink transition-colors">
      View all deals from {deal.origin} →
    </a>
  </section>

  <!-- ══ FOOTER ══ -->
  <footer class="border-t border-tcf-ink/10 px-6 py-10 text-center text-xs text-tcf-ink-muted">
    <p>© 2026 Texas Cheap Flights · <a href="/skeptics-guide" class="text-tcf-ink-muted hover:text-tcf-ink transition-colors no-underline">Skeptic's Guide</a> · <a href="/past-deals" class="text-tcf-ink-muted hover:text-tcf-ink transition-colors no-underline">All Deals</a> · <a href="/" class="text-tcf-ink-muted hover:text-tcf-ink transition-colors no-underline">Home</a></p>
  </footer>

</body>
</html>
