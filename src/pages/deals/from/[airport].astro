---
import '../../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { airport } = Astro.params;

const AIRPORTS: Record<string, { city: string, code: string }> = {
  MFE: { city: 'McAllen', code: 'MFE' },
  HRL: { city: 'Harlingen', code: 'HRL' },
  BRO: { city: 'Brownsville', code: 'BRO' },
  LRD: { city: 'Laredo', code: 'LRD' },
  CRP: { city: 'Corpus Christi', code: 'CRP' },
  MAF: { city: 'Midland / Odessa', code: 'MAF' },
  SAT: { city: 'San Antonio', code: 'SAT' },
  AUS: { city: 'Austin', code: 'AUS' },
  IAH: { city: 'Houston (Bush)', code: 'IAH' },
  HOU: { city: 'Houston (Hobby)', code: 'HOU' },
  DFW: { city: 'Dallas / Fort Worth', code: 'DFW' },
  DAL: { city: 'Dallas (Love Field)', code: 'DAL' },
  ELP: { city: 'El Paso', code: 'ELP' },
  LBB: { city: 'Lubbock', code: 'LBB' },
  AMA: { city: 'Amarillo', code: 'AMA' },
  GRK: { city: 'Killeen / Fort Hood', code: 'GRK' },
  TYR: { city: 'Tyler', code: 'TYR' },
  GGG: { city: 'Longview', code: 'GGG' },
  ABI: { city: 'Abilene', code: 'ABI' },
};

const airportData = AIRPORTS[airport?.toUpperCase() || ''];

if (!airportData) {
  return Astro.redirect('/past-deals');
}

const { data: deals } = await supabase
  .from('deals')
  .select('*')
  .eq('origin', airportData.code)
  .not('sent_at', 'is', null)
  .order('sent_at', { ascending: false });

const dealList = deals ?? [];

const title = `Cheap Flight Deals departing from ${airportData.city} (${airportData.code}) | Texas Cheap Flights`;
const description = `Live monitoring for ${airportData.city} flight deals. Error fares, award sweet spots, and airline glitches departing from ${airportData.code}. Scouted by Texans, for Texans.`;

// JSON-LD for the Hub Page
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${Astro.url.href}#webpage`,
      "url": Astro.url.href,
      "name": title,
      "description": description,
      "breadcrumb": {
        "@id": `${Astro.url.href}#breadcrumb`
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${Astro.url.href}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Texas Cheap Flights",
          "item": "https://texascheapflights.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": `Deals from ${airportData.city}`,
          "item": Astro.url.href
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://texascheapflights.com/og-image.png" />
  
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Satoshi:wght@400;500;700;900&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-tcf-navy-deep text-white min-h-screen">

  <GlobalNav activePage="past-deals" />

  <main class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      
      <header class="mb-16">
        <span class="text-tcf-gold font-bold text-xs uppercase tracking-[0.3em] mb-4 inline-block">Regional Scout Hub</span>
        <h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
          Flight Deals from <br/><span class="text-gold italic">{airportData.city} ({airportData.code})</span>
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl font-body leading-relaxed">
          We monitor every major airline and award program departing from {airportData.city}. No more generic alerts for DFW when you're flying out of {airportData.code}.
        </p>
      </header>

      {dealList.length > 0 ? (
        <div class="space-y-6">
          <h2 class="text-sm font-black text-white uppercase tracking-widest mb-8">Recent Alerts from {airportData.code}</h2>
          <div class="grid gap-4">
            {dealList.map((deal) => (
              <a href={`/deal/${deal.id}`} class="block liquid-glass p-6 rounded-2xl border border-white/5 hover:border-tcf-gold/30 transition-all duration-300 group no-underline text-inherit">
                <div class="flex justify-between items-center">
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class={`text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border ${deal.score >= 8 ? 'text-tcf-gold border-tcf-gold/30 bg-tcf-gold/5' : 'text-slate-500 border-white/10'}`}>
                            Score: {deal.score}/10
                        </span>
                        <span class="text-[10px] text-slate-500">{new Date(deal.sent_at).toLocaleDateString()}</span>
                    </div>
                    <div class="text-xl font-black text-white group-hover:text-tcf-gold transition-colors">{deal.origin} → {deal.destination}</div>
                    <div class="text-xs text-slate-500 mt-1">{deal.airline} · {deal.travel_dates}</div>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-black text-white">{deal.price ? `$${deal.price}` : 'Points'}</div>
                    <div class="text-[10px] text-slate-500 uppercase tracking-widest mt-1">Roundtrip</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="space-y-6">
          <!-- Scout Status Card -->
          <div class="p-8 rounded-[2rem] liquid-glass border border-tcf-gold/20">
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tcf-gold opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-tcf-gold"></span>
              </span>
              <span class="text-xs font-black text-tcf-gold uppercase tracking-[0.2em]">AI Scout Active — {airportData.code}</span>
            </div>
            <h3 class="text-2xl font-black text-white mb-3">No archived deals yet — Scout is watching.</h3>
            <p class="text-slate-400 leading-relaxed font-body max-w-xl">
              Our AI hasn't flagged a sendable deal from {airportData.city} yet, but the radar is live. Error fares and award arbitrage windows from {airportData.code} tend to be brief — most close within 2–4 hours. Subscribers get the alert the moment one surfaces.
            </p>
          </div>

          <!-- What We Watch For -->
          <div class="grid md:grid-cols-3 gap-4">
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
              <p class="text-xs font-black text-tcf-gold uppercase tracking-widest mb-3">Error Fares</p>
              <p class="text-sm text-slate-400 leading-relaxed font-body">Airline pricing glitches that slip through for hours before the carrier pulls them. Legal to book — most are honored.</p>
            </div>
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
              <p class="text-xs font-black text-tcf-aviation-blue uppercase tracking-widest mb-3">Zone Awards</p>
              <p class="text-sm text-slate-400 leading-relaxed font-body">Award programs price by zone, not distance. {airportData.code} often costs the same points as DFW or IAH to the same destination.</p>
            </div>
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
              <p class="text-xs font-black uppercase tracking-widest mb-3" style="color: var(--tcf-success)">Sweet Spots</p>
              <p class="text-sm text-slate-400 leading-relaxed font-body">Partner award pricing that's mispriced relative to cash. Rare but high-value — often 70–80% below retail.</p>
            </div>
          </div>

          <!-- CTA -->
          <div class="p-8 rounded-[2rem] bg-tcf-gold/5 border border-tcf-gold/20 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <p class="font-black text-white text-lg mb-1">Get the first alert when a deal drops from {airportData.city}.</p>
              <p class="text-sm text-slate-400 font-body">No spam. One alert per deal. Unsubscribe in one click.</p>
            </div>
            <a href="/#signup" class="btn-primary whitespace-nowrap no-underline" style="background: var(--tcf-gold); color: #050a14; font-weight: 900; padding: 0.75rem 2rem; border-radius: 9999px; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase;">
              Alert Me for {airportData.code}
            </a>
          </div>
        </div>
      )}

      <!-- Programmatic Content Section -->
      <section class="mt-24 pt-24 border-t border-white/5">
        <div class="grid md:grid-cols-2 gap-12">
            <article class="prose prose-invert prose-sm max-w-none">
                <h3 class="text-white font-black text-lg mb-4">Why monitor {airportData.city}?</h3>
                <p class="text-slate-400 leading-relaxed">
                    Departing from {airportData.code} often means you're limited to regional connections or high-priced hub jumps. However, award programs often price {airportData.code} to international destinations the same as DFW or IAH. This creates "Arbtirage Windows" where you can fly from your backyard for the same price as a major hub.
                </p>
            </article>
            <article class="prose prose-invert prose-sm max-w-none">
                <h3 class="text-white font-black text-lg mb-4">Best Strategy for {airportData.code}</h3>
                <p class="text-slate-400 leading-relaxed">
                    Our AI Scout specifically looks for Zone-Based redemptions and error fares that propagate to regional TX feeders. For {airportData.city} travelers, we recommend keeping a stash of transferable points to lock in these windows before they vanish.
                </p>
            </article>
        </div>
      </section>
    </div>
  </main>

  <footer class="py-20 border-t border-white/5 text-center text-xs text-slate-600">
    <p>© 2026 Texas Cheap Flights · <a href="/past-deals" class="text-slate-500 hover:text-white transition-colors no-underline">Back to All Deals</a></p>
  </footer>

</body>
</html>
