  .from('deals')
  .select('*')
  .eq('origin', airportData.code)
  .not('sent_at', 'is', null)
  .order('sent_at', { ascending: false });

const dealList = deals ?? [];
const lastUpdated = dealList[0]?.sent_at ? new Date(dealList[0].sent_at) : null;

