---
import '../../styles/global.css';
import GlobalNav from '../../components/GlobalNav.astro';
import GlobalFooter from '../../components/GlobalFooter.astro';
import { blogPosts, postsBySlug, publishedBlogPosts } from '../../data/blog';

export const prerender = true;

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post ?? postsBySlug.get(slug ?? '');

if (!post) {
  return Astro.redirect('/blog');
}

const canonicalUrl = `https://texascheapflights.com/blog/${post.slug}`;
const isDraft = post.status === 'draft';
const pageTitle = post.metaTitle || post.title;
const socialImage = post.heroImage?.src
  ? `https://texascheapflights.com${post.heroImage.src}`
  : 'https://texascheapflights.com/og-image.png';
const relatedPosts = publishedBlogPosts.filter((item) => item.slug !== post.slug).slice(0, 2);
const slugify = (value: string) => value
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');
const articleSections = post.sections.map((section, index) => ({
  ...section,
  id: `section-${index + 1}-${slugify(section.heading)}`,
}));
const formattedDate = new Date(post.updatedAt || post.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const tocItems = articleSections.map((section) => ({
  id: section.id,
  label: section.heading,
}));

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt || post.publishedAt,
  author: {
    '@type': 'Organization',
    name: 'Texas Cheap Flights',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Texas Cheap Flights',
    logo: {
      '@type': 'ImageObject',
      url: 'https://texascheapflights.com/logo-light.png',
    },
  },
  mainEntityOfPage: canonicalUrl,
  image: socialImage,
};

const faqJsonLd = post.faqs ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const jsonLd = faqJsonLd ? [blogPostingJsonLd, faqJsonLd] : blogPostingJsonLd;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle} | Texas Cheap Flights</title>
  <meta name="description" content={post.description} />
  {isDraft && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={post.description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Satoshi:wght@400;500;700;900&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="blog-article-page min-h-screen">
  <GlobalNav activePage="blog" />

  <main>
    <article>
      <header class="article-hero">
        <div class="article-hero__pattern"></div>
        <div class="article-hero__inner">
          <a href="/blog" class="article-back">Back to blog</a>
          <div class="article-kicker">
            <span>{post.category}</span>
            {isDraft && <span class="article-draft">Draft preview</span>}
            <span>{post.readingMinutes} min read</span>
            <time datetime={post.updatedAt || post.publishedAt}>{formattedDate}</time>
          </div>
          <h1>{post.title}</h1>
          <p>{post.description}</p>
          <div class="article-airports" aria-label="Related Texas airports">
            {post.primaryAirportCodes.map((code) => (
              <a href={`/deals/from/${code.toLowerCase()}`}>{code}</a>
            ))}
          </div>
        </div>
        {post.heroImage && (
          <figure class="article-hero-media">
            <img src={post.heroImage.src} alt={post.heroImage.alt} loading="eager" decoding="async" />
            {post.heroImage.caption && <figcaption>{post.heroImage.caption}</figcaption>}
          </figure>
        )}
      </header>

      <section class="article-shell">
        <aside class="article-toc" aria-label="Table of contents">
          <div class="article-rail-card">
            <p class="article-rail-label">In this article</p>
            <nav>
              {tocItems.map((item, index) => (
                <a href={`#${item.id}`}>
                  <span>{index + 1}</span>
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <div class="article-main">
          {post.tldr && (
            <section class="article-answer">
              <h2>TL;DR</h2>
              <ul>
                {post.tldr.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )}

          <div class="article-content">
            {articleSections.map((section) => (
              <section id={section.id} class="article-section">
                <h2>{section.heading}</h2>
                <div class="article-prose">
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {section.bullets && (
                  <ul class="article-bullets">
                    {section.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {section.table && (
                  <div class="article-table-wrap">
                    <table>
                      <thead>
                        <tr>
                          {section.table.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {section.table.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td>{cell}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                {section.image && (
                  <figure class="article-media">
                    <img src={section.image.src} alt={section.image.alt} loading="lazy" decoding="async" />
                    {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
                  </figure>
                )}
                {section.note && (
                  <p class="article-note" set:html={section.note} />
                )}
              </section>
            ))}
            {post.faqs && (
              <section class="article-faq">
                <h2>Common Questions</h2>
                <div>
                  {post.faqs.map((faq) => (
                    <section>
                      <h3>{faq.question}</h3>
                      <p>{faq.answer}</p>
                    </section>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>

        <aside class="article-aside" aria-label="Related resources">
          <div class="article-rail-card article-cta-card">
            <p class="article-rail-label">Next move</p>
            <h2>Get Texas fare alerts before the deal disappears.</h2>
            <p>Airport-specific alerts when fares move below normal pricing.</p>
            <a href="/#waitlist">Join the Scout List</a>
          </div>
          <div class="article-rail-card">
            <p class="article-rail-label">Related guides</p>
            <div class="article-related-list">
              {post.relatedLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>
          <div class="article-rail-card article-note-card">
            <p class="article-rail-label">Editorial note</p>
            <p>This article is written from our own Texas travel planning experience. Card offers and award pricing can change.</p>
          </div>
        </aside>
      </section>
    </article>

    <section class="article-keep-reading">
      <div>
        <p>Keep reading</p>
        <div class="article-card-grid">
          {relatedPosts.map((item) => (
            <a href={`/blog/${item.slug}`}>
              <p>{item.category}</p>
              <h2>{item.title}</h2>
              <span>{item.description}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <GlobalFooter />
</body>
</html>

<style>
  .blog-article-page {
    background:
      linear-gradient(180deg, #f6fbff 0%, #fffdf7 24rem, #f7f8f2 100%);
    color: var(--tcf-ink);
  }

  .article-hero {
    position: relative;
    overflow: hidden;
    padding: 7.75rem 1.5rem 3.1rem;
    background:
      linear-gradient(135deg, rgba(217, 236, 255, 0.95), rgba(255, 253, 247, 0.96)),
      radial-gradient(circle at 86% 20%, rgba(212, 168, 67, 0.22), transparent 28%);
    border-bottom: 1px solid rgba(16, 32, 51, 0.09);
  }

  .article-hero__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    background-image:
      linear-gradient(rgba(16, 32, 51, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 32, 51, 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    pointer-events: none;
  }

  .article-hero__inner {
    position: relative;
    max-width: 70rem;
    margin: 0 auto;
  }

  .article-back,
  .article-kicker,
  .article-rail-label {
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .article-back {
    display: inline-flex;
    color: #5a6878;
    text-decoration: none;
    margin-bottom: 1.45rem;
  }

  .article-back:hover,
  .article-toc a:hover,
  .article-related-list a:hover {
    color: var(--tcf-gold);
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    color: #607084;
    margin-bottom: 1.1rem;
  }

  .article-kicker span,
  .article-kicker time {
    border: 1px solid rgba(16, 32, 51, 0.1);
    background: rgba(255, 255, 255, 0.62);
    border-radius: 999px;
    padding: 0.42rem 0.68rem;
  }

  .article-kicker .article-draft {
    color: var(--tcf-gold);
    border-color: rgba(212, 168, 67, 0.35);
    background: rgba(212, 168, 67, 0.1);
  }

  .article-hero h1 {
    max-width: 62rem;
    color: #102033;
    font-size: 3.45rem;
    line-height: 1.06;
    letter-spacing: 0;
    margin: 0 0 1.05rem;
  }

  .article-hero p {
    max-width: 50rem;
    color: #4c5c6d;
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    line-height: 1.65;
  }

  .article-airports {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }

  .article-airports a {
    min-width: 3.25rem;
    text-align: center;
    border: 1px solid rgba(16, 32, 51, 0.12);
    background: #fff;
    color: #102033;
    border-radius: 999px;
    padding: 0.52rem 0.78rem;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .article-hero-media {
    position: relative;
    z-index: 1;
    max-width: 70rem;
    margin: 2rem auto 0;
    border: 1px solid rgba(16, 32, 51, 0.12);
    border-radius: 1.4rem;
    overflow: hidden;
    background: #102033;
    box-shadow: 0 28px 70px rgba(16, 32, 51, 0.18);
  }

  .article-hero-media img,
  .article-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-hero-media img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-hero-media figcaption,
  .article-media figcaption {
    margin: 0;
    color: #526174;
    background: rgba(255, 255, 255, 0.92);
    border-top: 1px solid rgba(16, 32, 51, 0.08);
    padding: 0.8rem 1rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .article-shell {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 46rem) minmax(0, 17rem);
    gap: 2rem;
    align-items: start;
    max-width: 82rem;
    margin: 0 auto;
    padding: 2.6rem 1.5rem 5rem;
  }

  .article-toc,
  .article-aside {
    position: sticky;
    top: 6.75rem;
  }

  .article-main {
    min-width: 0;
  }

  .article-rail-card,
  .article-answer,
  .article-content,
  .article-cta-card,
  .article-note-card,
  .article-keep-reading a {
    border: 1px solid rgba(16, 32, 51, 0.1);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 18px 50px rgba(16, 32, 51, 0.08);
  }

  .article-rail-card {
    border-radius: 1.15rem;
    padding: 1.15rem;
  }

  .article-rail-card + .article-rail-card {
    margin-top: 1rem;
  }

  .article-rail-label {
    color: #9a7a2d;
    margin: 0 0 1rem;
  }

  .article-toc nav {
    display: grid;
    gap: 0.75rem;
  }

  .article-toc a,
  .article-related-list a {
    color: #39495b;
    font-family: 'Outfit', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .article-toc a {
    display: grid;
    grid-template-columns: 1.45rem 1fr;
    gap: 0.55rem;
  }

  .article-toc a span {
    color: var(--tcf-gold);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .article-answer {
    border-color: rgba(212, 168, 67, 0.28);
    background: linear-gradient(135deg, rgba(255, 253, 247, 0.98), rgba(255, 247, 223, 0.96));
    border-radius: 1.4rem;
    padding: 2rem;
    margin-bottom: 1.25rem;
  }

  .article-answer h2,
  .article-section h2,
  .article-faq h2,
  .article-cta-card h2,
  .article-keep-reading h2 {
    letter-spacing: 0;
  }

  .article-answer h2 {
    color: #102033;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }

  .article-answer ul,
  .article-bullets {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-answer li,
  .article-bullets li {
    position: relative;
    padding-left: 1.4rem;
    color: #35465a;
    font-family: 'Outfit', sans-serif;
    line-height: 1.62;
  }

  .article-answer li + li,
  .article-bullets li + li {
    margin-top: 0.75rem;
  }

  .article-answer li::before,
  .article-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: var(--tcf-gold);
  }

  .article-content {
    border-radius: 1.4rem;
    padding: 2.55rem;
  }

  .article-section {
    scroll-margin-top: 7rem;
  }

  .article-section + .article-section,
  .article-faq {
    margin-top: 3.25rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(16, 32, 51, 0.1);
  }

  .article-section h2,
  .article-faq h2 {
    color: #102033;
    font-size: 2.05rem;
    line-height: 1.12;
    margin: 0 0 1.2rem;
  }

  .article-prose {
    display: grid;
    gap: 1rem;
  }

  .article-prose p,
  .article-faq p,
  .article-note-card p,
  .article-cta-card p {
    color: #405267;
    font-family: 'Outfit', sans-serif;
    font-size: 1.04rem;
    line-height: 1.82;
    margin: 0;
  }

  .article-bullets {
    margin-top: 1.35rem;
    display: grid;
    gap: 0.65rem;
  }

  .article-table-wrap {
    margin-top: 1.6rem;
    overflow-x: auto;
    border: 1px solid rgba(16, 32, 51, 0.1);
    border-radius: 1rem;
  }

  .article-table-wrap table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
  }

  .article-table-wrap th {
    background: #eef5f8;
    color: #526174;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-table-wrap th,
  .article-table-wrap td {
    padding: 0.95rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(16, 32, 51, 0.08);
  }

  .article-table-wrap td {
    color: #26384c;
  }

  .article-table-wrap tr:last-child td {
    border-bottom: 0;
  }

  .article-media {
    margin: 1.6rem 0 0;
    border: 1px solid rgba(16, 32, 51, 0.1);
    border-radius: 1.1rem;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 40px rgba(16, 32, 51, 0.08);
  }

  .article-note {
    border: 1px dashed rgba(212, 168, 67, 0.45);
    background: rgba(212, 168, 67, 0.09);
    color: #6d5a27;
    border-radius: 1rem;
    padding: 1rem;
    margin: 1.4rem 0 0;
    font-family: 'Outfit', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .article-faq > div {
    display: grid;
    gap: 0.85rem;
  }

  .article-faq section {
    border: 1px solid rgba(16, 32, 51, 0.09);
    border-radius: 1rem;
    padding: 1.1rem;
    background: #fbfdf8;
  }

  .article-faq h3 {
    color: #102033;
    font-size: 1.05rem;
    letter-spacing: 0;
    margin: 0 0 0.45rem;
  }

  .article-cta-card {
    background:
      linear-gradient(160deg, #102033, #172d44);
    color: white;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .article-cta-card .article-rail-label {
    color: var(--tcf-gold);
  }

  .article-cta-card h2 {
    color: white;
    font-size: 1.25rem;
    line-height: 1.18;
    margin: 0 0 0.8rem;
  }

  .article-cta-card p {
    color: #c8d3df;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .article-cta-card a {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    margin-top: 1rem;
    border-radius: 999px;
    background: var(--tcf-gold);
    color: #102033;
    padding: 0.8rem 1rem;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .article-related-list {
    display: grid;
    gap: 0.85rem;
  }

  .article-note-card {
    background: rgba(255, 255, 255, 0.58);
    box-shadow: none;
  }

  .article-note-card p {
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .article-keep-reading {
    padding: 4rem 1.5rem 5rem;
    background: #eef7f8;
    border-top: 1px solid rgba(16, 32, 51, 0.08);
  }

  .article-keep-reading > div {
    max-width: 58rem;
    margin: 0 auto;
  }

  .article-keep-reading > div > p {
    color: #9a7a2d;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 0 1rem;
  }

  .article-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-keep-reading a {
    display: block;
    border-radius: 1.15rem;
    padding: 1.25rem;
    color: #102033;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .article-keep-reading a:hover {
    transform: translateY(-2px);
    border-color: rgba(212, 168, 67, 0.45);
  }

  .article-keep-reading a p {
    color: #9a7a2d;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }

  .article-keep-reading a h2 {
    color: #102033;
    font-size: 1.2rem;
    line-height: 1.18;
    margin: 0 0 0.6rem;
  }

  .article-keep-reading a span {
    color: #526174;
    font-family: 'Outfit', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 1120px) {
    .article-shell {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    }

    .article-aside {
      position: static;
      grid-column: 2;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .article-aside .article-rail-card + .article-rail-card {
      margin-top: 0;
    }

    .article-note-card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 820px) {
    .article-hero {
      padding-top: 7.25rem;
      padding-bottom: 2.4rem;
    }

    .article-shell {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 1.5rem;
    }

    .article-hero h1 {
      font-size: 2.25rem;
      line-height: 1.04;
    }

    .article-hero p {
      font-size: 1.08rem;
    }

    .article-hero-media {
      margin-top: 1.35rem;
      border-radius: 1rem;
    }

    .article-hero-media figcaption,
    .article-media figcaption {
      font-size: 0.84rem;
    }

    .article-answer,
    .article-content {
      padding: 1.35rem;
    }

    .article-section h2,
    .article-faq h2 {
      font-size: 1.55rem;
    }

    .article-toc,
    .article-aside {
      position: static;
    }

    .article-aside {
      grid-column: auto;
      grid-template-columns: 1fr;
