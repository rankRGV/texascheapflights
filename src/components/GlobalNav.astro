---
interface Props {
  activePage?: 'home' | 'past-deals' | 'skeptics-guide' | 'welcome' | 'admin';
}
const { activePage } = Astro.props;

const NAV_LINKS = [
  { label: 'The Strategy', href: '/#how-it-works' },
  { label: "Skeptic's Guide", href: '/skeptics-guide' },
  { label: 'Past Deals', href: '/past-deals' },
];
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 px-6 py-5 transition-all duration-300 border-b border-white/5" style="background: rgba(5, 10, 20, 0.85); backdrop-filter: blur(16px);">
  <div class="max-w-7xl mx-auto flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 no-underline group">
      <div class="p-2 rounded-xl bg-tcf-aviation-blue/10 border border-tcf-aviation-blue/20 transition-all duration-300 group-hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-tcf-aviation-blue"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
      </div>
      <div class="flex flex-col leading-none">
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-tcf-gold mb-0.5">Texas</span>
        <span class="font-black text-base uppercase tracking-tight text-white">Cheap Flights</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden lg:flex items-center gap-10">
      {NAV_LINKS.map(link => (
        <a
          href={link.href}
          class={`text-[10px] font-black uppercase tracking-[0.2em] transition-colors no-underline ${
            (activePage === 'past-deals' && link.href === '/past-deals') ||
            (activePage === 'skeptics-guide' && link.href === '/skeptics-guide')
              ? 'text-tcf-gold border-b border-tcf-gold/50 pb-0.5'
              : 'text-slate-400 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTA + Mobile hamburger -->
    <div class="flex items-center gap-4">
      <a href="/#waitlist" class="hidden sm:inline-flex btn-primary" style="padding: 0.65rem 1.5rem; font-size: 0.8rem;">
        Get Early Access
      </a>

      <!-- Hamburger -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        class="lg:hidden w-10 h-10 flex flex-col items-center justify-center gap-[5px] rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors"
      >
        <span class="hamburger-line block w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
        <span class="hamburger-line block w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
        <span class="hamburger-line block w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Slide-Down Drawer -->
<div
  id="mobile-menu"
  class="fixed top-0 left-0 right-0 bottom-0 z-40 flex flex-col lg:hidden"
  style="pointer-events: none; opacity: 0; transition: opacity 0.25s ease;"
>
  <!-- Backdrop -->
  <div class="absolute inset-0" style="background: rgba(5, 10, 20, 0.96); backdrop-filter: blur(20px);"></div>

  <!-- Menu Content -->
  <div class="relative z-10 flex flex-col items-center justify-center gap-8 h-full text-center px-8">
    <a href="/" class="text-3xl font-black text-white uppercase tracking-tight hover:text-tcf-gold transition-colors no-underline">Home</a>
    {NAV_LINKS.map(link => (
      <a href={link.href} class="text-3xl font-black text-slate-300 uppercase tracking-tight hover:text-tcf-gold transition-colors no-underline mobile-nav-link">
        {link.label}
      </a>
    ))}
    <a href="/#waitlist" class="mt-4 btn-primary text-base px-10 py-4 no-underline mobile-nav-link">
      Get Early Access →
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const lines = btn?.querySelectorAll('.hamburger-line');

  let isOpen = false;

  function toggleMenu(open: boolean) {
    isOpen = open;
    if (!menu || !btn) return;

    if (open) {
      menu.style.opacity = '1';
      menu.style.pointerEvents = 'auto';
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      // Animate to X
      if (lines) {
        (lines[0] as HTMLElement).style.transform = 'translateY(7px) rotate(45deg)';
        (lines[1] as HTMLElement).style.opacity = '0';
        (lines[2] as HTMLElement).style.transform = 'translateY(-7px) rotate(-45deg)';
      }
    } else {
      menu.style.opacity = '0';
      menu.style.pointerEvents = 'none';
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      // Animate back to hamburger
      if (lines) {
        (lines[0] as HTMLElement).style.transform = '';
        (lines[1] as HTMLElement).style.opacity = '1';
        (lines[2] as HTMLElement).style.transform = '';
      }
    }
  }

  btn?.addEventListener('click', () => toggleMenu(!isOpen));

  // Close on nav link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
